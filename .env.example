# Caddy reverse-proxy address. ":80" is fine for local dev (Caddy serves
# plain HTTP on the inside; host port mapping is in docker-compose.yml).
SITE_HOST=:80

# Default host port mappings (overridable):
HTTP_PORT=8081
HTTPS_PORT=8444

# API keys — DB values entered in the Settings UI take precedence over these.
AHREFS_API_KEY=
GEMINI_API_KEY=
GITHUB_MODELS_TOKEN=
OPENROUTER_API_KEY=

# Where the SQLite database lives inside the api container.
DATABASE_URL=sqlite:////data/drop_sherlock.db

# Default rate limits — overridable in the Settings UI per API.
AHREFS_RPM=60
AHREFS_MAX_CONCURRENT_DOMAINS=4
AHREFS_RETRY_MAX=3

# Comma-separated list of origins allowed to call the /api endpoints.
# Set to "*" only for development. In production, set to your real
# Caddy URL(s), e.g.:
#   CORS_ALLOW_ORIGINS=http://drop-sherlock.lan:8081
# The default below covers the local Docker stack.
CORS_ALLOW_ORIGINS=http://localhost:8081,https://localhost:8444

# HTTP basic auth at the Caddy reverse proxy. Required — Caddy will
# fail to start if these are unset. Generates a bcrypt hash:
#
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR-PASS'
#
# Paste the entire output (starts with "$2a$") as BASIC_AUTH_PASSWORD_HASH.
# IMPORTANT: when storing the hash in `.env`, escape every `$` as `$$`
# because Docker Compose interpolates `$VAR` references in env_file
# values. Example:
#   BASIC_AUTH_PASSWORD_HASH=$$2a$$14$$abcdef...
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD_HASH=

# At-rest encryption key for provider API keys and S3 backup credentials
# stored in the SQLite app_settings table. Without encryption, anyone who
# exfiltrates `data/drop_sherlock.db` gets the raw keys.
#
# Comma-separated list — first key is "primary" (used for new writes);
# additional keys decrypt legacy values for graceful rotation.
#
# Generate a key with:
#   docker run --rm python:3.12-slim sh -c "pip install -q cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
#
# If left blank, the app auto-generates one on first boot and stores it
# at /data/.fernet_key (inside the api container's volume). That file
# survives restarts but lives next to the DB — for stricter separation
# (key in env / secret manager, DB on disk), set FERNET_KEYS here and
# delete the file.
#
# CRITICAL: if you ever lose the key (env unset AND /data/.fernet_key
# missing), encrypted secrets in the DB cannot be recovered. Back up
# the key alongside DB snapshots.
FERNET_KEYS=
