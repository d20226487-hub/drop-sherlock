# Caddy config when this stack is fronted by Traefik (or any other outer
# reverse proxy). Differences from the standalone Caddyfile:
#
#   - No `{$SITE_HOST}` host matching — we listen on a fixed internal
#     port (443) for any Host header, because Traefik already routed
#     to us by Host(`drop-sherlock.<your-domain>`).
#   - `auto_https off` — Caddy is no longer the outermost server, so it
#     must not try to issue or redirect for ACME. Traefik handles the
#     public TLS; this cert is only for the Caddy↔Traefik internal hop.
#   - A self-signed cert pair from /certs/ is used so Traefik can talk
#     HTTPS to us with `insecureSkipVerify: true` — matches your
#     existing `nginx-tool-1` backend pattern.
#
# Basicauth + security headers are KEPT — defense in depth on top of
# Traefik's IP-whitelist middleware. Anyone who somehow reaches Caddy
# from inside the VPN still needs the basicauth credential.
#
# Public view-only share routes (/share/* + /api/public/*) bypass
# basicauth here too, mirroring the standalone Caddyfile. The actual
# access control happens inside the backend share-token handler.

{
  auto_https off
}

:443 {
  tls /certs/selfsigned.crt /certs/selfsigned.key

  encode zstd gzip

  # Defense-in-depth headers — same set as the standalone Caddyfile.
  # HSTS only meaningful on the public-facing TLS (which Traefik owns),
  # but harmless here.
  header {
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'"
    Strict-Transport-Security "max-age=31536000"
  }

  # Public share routes — no basicauth.
  handle /share/* {
    reverse_proxy web:3000
  }
  # Next.js static assets (hashed bundles, no operator data) and a
  # few root-level static files — must be reachable without basicauth
  # so the share page can hydrate in an incognito tab. See the
  # standalone Caddyfile for the rationale.
  handle /_next/* {
    reverse_proxy web:3000
  }
  # Browser auto-discovery paths — same list as the standalone
  # Caddyfile. These MUST be reachable without basicauth or the
  # browser pops the credential dialog the share is supposed to
  # avoid. Targets go through to Next.js which returns 404 for any
  # asset that doesn't exist — no auth challenge along the way.
  handle /favicon.ico {
    reverse_proxy web:3000
  }
  handle /favicon.svg {
    reverse_proxy web:3000
  }
  handle /icon.svg {
    reverse_proxy web:3000
  }
  handle /icon.png {
    reverse_proxy web:3000
  }
  handle /icon-*.png {
    reverse_proxy web:3000
  }
  handle /apple-icon.png {
    reverse_proxy web:3000
  }
  handle /apple-touch-icon.png {
    reverse_proxy web:3000
  }
  handle /apple-touch-icon-precomposed.png {
    reverse_proxy web:3000
  }
  handle /apple-touch-icon-*.png {
    reverse_proxy web:3000
  }
  handle /manifest.json {
    reverse_proxy web:3000
  }
  handle /manifest.webmanifest {
    reverse_proxy web:3000
  }
  handle /robots.txt {
    reverse_proxy web:3000
  }
  handle /sitemap.xml {
    reverse_proxy web:3000
  }
  handle /api/public/* {
    # Strip `/api` so the backend's FastAPI router (mounted at
    # `/public`) sees `/public/share/<token>`. Mirrors the
    # `handle_path /api/*` strip in the catch-all block below.
    uri strip_prefix /api
    reverse_proxy api:8000
  }

  # Everything else: basicauth + normal routing.
  handle {
    basicauth {
      {$BASIC_AUTH_USERNAME} {$BASIC_AUTH_PASSWORD_HASH}
    }

    handle_path /api/* {
      reverse_proxy api:8000
    }

    reverse_proxy web:3000
  }
}
